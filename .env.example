# Copy to .env and adjust. .env is git-ignored.

# Where books, covers, the database and backups live.
ATLAS_DATA_DIR=data

# Optional: override the SQLite URL (default: <data_dir>/database/atlas.db)
# ATLAS_DATABASE_URL=sqlite:////absolute/path/atlas.db

# Session lifetime in days.
ATLAS_SESSION_DAYS=30

# Set true when served over HTTPS (e.g. tailscale serve).
ATLAS_COOKIE_SECURE=false

# Login rate limit: failures allowed per window (seconds) per client.
ATLAS_LOGIN_MAX_FAILURES=5
ATLAS_LOGIN_WINDOW_SECONDS=300
